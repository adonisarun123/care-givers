# Live domain — used for canonical URLs, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://your-domain.in

# Where booking requests from /book are sent (JSON POST).
# Works with Zapier/Make "catch hook", a Google Apps Script web app, or a CRM webhook.
# If unset, families are asked to send their request on WhatsApp instead.
BOOKING_WEBHOOK_URL=
